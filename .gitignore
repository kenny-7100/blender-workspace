# Local Blender runtime, installers, preferences and downloaded extensions.
# All modeling projects are private: inputs, scripts, parameters, models,
# textures, previews, reports and project-specific notes remain local.
/projects/
/Open-Vinegar-Bottle.command

/apps/
/downloads/
/config/
/cache/
/tmp/
/extensions/
/datafiles/

# Machine-specific files and credentials.
.DS_Store
._*
.local/
.env
.env.*
!.env.example
*.pem
*.key

# Blender autosaves, backups and runtime reports.
*.blend[0-9]*
*.blend@
*.log
*.crash.txt

# Regenerable per-run outputs; curated working files and previews stay tracked.
/projects/**/outputs/
/projects/**/renders/
/projects/**/cache/
/projects/**/references/originals/
/projects/**/references/frames/

# Python and editor caches.
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.idea/
.vscode/
