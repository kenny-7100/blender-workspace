#!/bin/zsh
set -eu
BLENDER_WORKSPACE=${0:A:h:h}
export BLENDER_USER_CONFIG="$BLENDER_WORKSPACE/config"
export BLENDER_USER_SCRIPTS="$BLENDER_WORKSPACE/scripts"
export BLENDER_USER_DATAFILES="$BLENDER_WORKSPACE/datafiles"
export BLENDER_USER_EXTENSIONS="$BLENDER_WORKSPACE/extensions"
export XDG_CACHE_HOME="$BLENDER_WORKSPACE/cache"
export TMPDIR="$BLENDER_WORKSPACE/tmp/"
mkdir -p "$BLENDER_USER_CONFIG" "$BLENDER_USER_SCRIPTS" "$BLENDER_USER_DATAFILES" \
  "$BLENDER_USER_EXTENSIONS" "$XDG_CACHE_HOME" "$TMPDIR"
exec "$BLENDER_WORKSPACE/apps/Blender.app/Contents/MacOS/Blender" "$@"
